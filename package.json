{
  "name": "moocafisio",
  "version": "1.0.1",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "shared"
  ],
  "scripts": {
    "dev": "node scripts/check-env.js && vite",
    "dev:host": "cd packages/host && npm run dev",
    "dev:agenda": "cd packages/agenda-pacientes && npm run dev",
    "dev:tratamentos": "cd packages/tratamentos && npm run dev",
    "dev:financeiro": "cd packages/financeiro && npm run dev",
    "build:all": "npm run build --workspace=packages/host && npm run build --workspace=packages/agenda-pacientes && npm run build --workspace=packages/tratamentos && npm run build --workspace=packages/financeiro",
    "clean": "rimraf packages/*/node_modules packages/*/dist shared/node_modules",
    "dev:clean": "powershell -ExecutionPolicy Bypass -File scripts/dev-clean.ps1",
    "dev:skip-check": "vite",
    "kill:servers": "powershell -ExecutionPolicy Bypass -File scripts/kill-all-servers.ps1",
    "kill:node": "powershell -ExecutionPolicy Bypass -File scripts/kill-node.ps1",
    "build": "vite build && node scripts/check-bundle-size.cjs && npm run validate",
    "build:fast": "vite build",
    "build:optimized": "node scripts/measure-build.cjs",
    "build:optimized:core": "npm run clean:cache && vite build --mode production && npm run post-build:optimize",
    "build:incremental": "vite build --mode production --incremental",
    "vercel-build": "npm run build:optimized",
    "build:analyze": "vite build && start dist/stats.html",
    "build:check": "node scripts/check-bundle-size.cjs",
    "validate": "tsx scripts/validate-build.ts",
    "clean:cache": "if exist node_modules\\.vite rmdir /s /q node_modules\\.vite && if exist dist rmdir /s /q dist && if exist .vercel\\cache rmdir /s /q .vercel\\cache && npm cache clean --force",
    "post-build:optimize": "node scripts/post-build-optimize.cjs",
    "check:performance": "tsx scripts/check-performance-budget.ts",
    "track:bundle": "tsx scripts/track-bundle-size.ts",
    "lighthouse": "lhci autorun",
    "start": "vite preview",
    "vercel:deploy": "vercel --prod",
    "setup": "node scripts/setup-env.js",
    "check:env": "node scripts/check-env.js",
    "lint": "eslint . --ext ts,tsx --report-unused-disable-directives --max-warnings 0",
    "lint:fix": "eslint . --ext ts,tsx --fix",
    "lint:bundle": "eslint . --ext ts,tsx -c .eslintrc-bundle-optimization.json",
    "type-check": "tsc --noEmit",
    "test": "vitest",
    "test:unit": "vitest run",
    "test:unit:watch": "vitest watch",
    "test:unit:ui": "vitest --ui",
    "test:unit:coverage": "vitest run --coverage",
    "test:e2e": "powershell -ExecutionPolicy Bypass -File scripts/run-e2e-tests-smart.ps1",
    "test:e2e:validate": "tsx scripts/validate-e2e-environment.ts",
    "test:e2e:seed": "tsx scripts/seed-e2e-test-data-fixed.ts",
    "test:e2e:seed:clean": "tsx scripts/seed-e2e-test-data-fixed.ts --clean",
    "test:e2e:with-seed": "powershell -ExecutionPolicy Bypass -File scripts/run-e2e-with-seed.ps1",
    "test:e2e:direct": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:port": "powershell -ExecutionPolicy Bypass -Command \"./scripts/prepare-e2e.ps1 | ForEach-Object { $env:PLAYWRIGHT_BASE_URL='http://localhost:' + $_; npx playwright test tests/e2e/appointment-flow.spec.ts }\"",
    "test:e2e:complete": "playwright test tests/e2e/ --reporter=list",
    "test:e2e:comprehensive": "node scripts/run-comprehensive-test.cjs all",
    "test:e2e:admin": "node scripts/run-comprehensive-test.cjs admin",
    "test:e2e:therapist": "node scripts/run-comprehensive-test.cjs therapist",
    "test:e2e:patient": "node scripts/run-comprehensive-test.cjs patient",
    "test:e2e:educator": "node scripts/run-comprehensive-test.cjs educator",
    "test:responsive": "playwright test tests/responsive/ --reporter=list",
    "test:a11y": "playwright test tests/accessibility/ --reporter=list",
    "test:integration": "playwright test tests/integration/ --reporter=list",
    "test:security": "playwright test tests/security/ --reporter=list",
    "test:performance": "playwright test --config=playwright.config.performance.ts",
    "test:performance:report": "playwright show-report playwright-report/performance",
    "test:all": "npm run test:unit:coverage && npm run test:e2e",
    "test:full": "npm run test:e2e:complete && npm run test:responsive && npm run test:a11y",
    "test:report": "playwright show-report",
    "check": "npm run type-check && npm run lint && npm run test:unit",
    "check:fix": "npm run lint:fix && npm run type-check",
    "seed": "ts-node scripts/seed-new-modules.ts",
    "seed:modules": "ts-node scripts/seed-new-modules.ts",
    "generate:icons": "node scripts/generate-pwa-icons.cjs",
    "generate:icons:from-logo": "node scripts/generate-pwa-icons-from-logo.cjs",
    "convert:webp": "node scripts/convert-images-to-webp.cjs",
    "maintenance": "node scripts/maintenance.js --health",
    "maintenance:update": "node scripts/maintenance.js --update",
    "maintenance:full": "node scripts/maintenance.js --health --update",
    "security": "npm audit --audit-level=moderate",
    "deps:check": "npm outdated",
    "deps:update": "npm update",
    "bundle:analyze": "npm run build && firefox dist/stats.html",
    "bundle:analyze:size": "node scripts/analyze-bundle-size.cjs",
    "bundle:size": "npm run build && du -sh dist && du -sh dist/assets/*.js | sort -hr | head -20",
    "activity:setup": "node scripts/setup-activity-integration.js",
    "activity:migrate": "npx supabase db push",
    "activity:test": "node scripts/test-activity-integration.js",
    "whatsapp:notifications": "node scripts/whatsapp-daily-notifications.js",
    "whatsapp:test-webhook": "node scripts/test-whatsapp-webhook.js",
    "whatsapp:server": "node webhook-server.js",
    "start:whatsapp": "tsx scripts/start-whatsapp.ts",
    "whatsapp:pm2": "pm2 start scripts/start-whatsapp.ts --name whatsapp-service --interpreter tsx",
    "whatsapp:logs": "pm2 logs whatsapp-service",
    "whatsapp:stop": "pm2 stop whatsapp-service",
    "whatsapp:restart": "pm2 restart whatsapp-service",
    "whatsapp:status": "pm2 status whatsapp-service",
    "generate:clinical-content": "npx tsx scripts/populate-clinical-content.ts",
    "clinical:generate": "node scripts/run-clinical-content-generator.js",
    "setup:auth": "node scripts/setup-auth.js",
    "setup:test-users": "node scripts/create-test-users.js",
    "test:calendar": "node scripts/test-calendar.js",
    "generate:cron-secret": "node scripts/generate-cron-secret.js",
    "check:deployment": "node scripts/check-deployment.js",
    "verify:bundle-hash": "node scripts/verify-bundle-hash.js",
    "deploy:validate": "node scripts/validate-deployment.js",
    "sentry:validate": "node scripts/validate-sentry-setup.js",
    "setup:complete": "npm run setup:auth && npm run check:deployment && npm run test:calendar",
    "perf:local": "node scripts/lighthouse-performance.js http://localhost:4173",
    "perf:prod": "node scripts/lighthouse-performance.js https://moocafisio.com.br",
    "perf:staging": "node scripts/lighthouse-performance.js https://dudufisio-git-main-rafael-minattos-projects.vercel.app",
    "test:mobile": "node scripts/test-mobile-loading.js",
    "fix:radix": "bash scripts/fix-radix-ui-build.sh",
    "fix:radix:win": "powershell -ExecutionPolicy Bypass -File scripts/fix-radix-ui-build.ps1",
    "fix:build": "powershell -ExecutionPolicy Bypass -File scripts/fix-build-simple.ps1",
    "security:audit": "node scripts/security-audit.cjs",
    "security:check": "npm audit && npm outdated @vercel/node",
    "monitor:health": "node scripts/monitor-health.cjs",
    "test:evolution": "playwright test tests/e2e/session-evolution-complete.spec.ts",
    "test:templates": "playwright test tests/e2e/conduct-templates.spec.ts",
    "test:keyboard": "playwright test tests/e2e/keyboard-shortcuts.spec.ts",
    "test:patient-data": "playwright test tests/e2e/patient-data-integration.spec.ts",
    "test:critical": "playwright test tests/e2e/session-evolution-complete.spec.ts tests/e2e/conduct-templates.spec.ts tests/e2e/keyboard-shortcuts.spec.ts",
    "report:daily": "node scripts/daily-summary.cjs",
    "check:dependencies": "node scripts/check-dependencies.cjs",
    "alert:vulnerabilities": "node scripts/alert-vulnerabilities.cjs",
    "design-system:dev": "vite --config vite.config.design-system.ts",
    "design-system:build": "vite build --config vite.config.design-system.ts",
    "design-system:preview": "vite preview --config vite.config.design-system.ts --port 3001",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build"
  },
