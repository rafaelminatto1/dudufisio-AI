# Configuração NPM para o projeto MoocaFisio

# Usa legacy peer deps para resolver conflitos de dependências
# (necessário devido a algumas incompatibilidades entre pacotes)
legacy-peer-deps=true

# Salva versões exatas no package.json (boa prática para produção)
save-exact=false

# Engine strict para garantir compatibilidade de versão Node
engine-strict=false

