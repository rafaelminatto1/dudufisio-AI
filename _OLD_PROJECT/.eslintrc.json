{
  "root": true,
  "ignorePatterns": ["dist", "build", "node_modules"],
  "rules": {
    "no-console": ["error", { "allow": ["warn", "error"] }]
  },
  "overrides": [
    {
      "files": [
        "lib/checkin/**/*.{ts,tsx}",
        "lib/compliance/**/*.{ts,tsx}",
        "lib/analytics/**/*.{ts,tsx}"
      ],
      "rules": {
        "no-console": "error",
        "@typescript-eslint/no-explicit-any": "warn"
      }
    },
    {
      "files": ["lib/logger.ts", "lib/secureLogger.ts", "lib/middleware/logger.ts"],
      "rules": {
        "no-console": "off"
      }
    },
    {
      "files": ["**/*.spec.ts", "**/*.test.ts", "tests/**/*", "scripts/**/*"],
      "rules": {
        "no-console": "off"
      }
    }
  ]
}
