{
  "name": "MoocaFisio - Gestão de Clínicas de Fisioterapia",
  "short_name": "MoocaFisio",
  "description": "Sistema completo de gestão para clínicas de fisioterapia com IA integrada",
  "start_url": "/",
  "display": "standalone",
  "background_color": "#ffffff",
  "theme_color": "#3b82f6",
  "orientation": "portrait-primary",
  "scope": "/",
  "lang": "pt-BR",
  "dir": "ltr",
  "categories": ["health", "medical", "productivity", "business"],
  "icons": [
    {
      "src": "/logo-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any maskable"
    },
    {
      "src": "/logo-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any maskable"
    },
    {
      "src": "/apple-touch-icon.png",
      "sizes": "180x180",
      "type": "image/png"
    }
  ],
  "shortcuts": [
    {
      "name": "Agendar Consulta",
      "short_name": "Agendar",
      "description": "Criar novo agendamento rapidamente",
      "url": "/agenda?action=new"
    },
    {
      "name": "Ver Agenda",
      "short_name": "Agenda",
      "description": "Visualizar agenda do dia",
      "url": "/agenda"
    },
    {
      "name": "Pacientes",
      "short_name": "Pacientes",
      "description": "Lista de pacientes",
      "url": "/patients"
    }
  ],
  "share_target": {
    "action": "/share-target",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "title": "title",
      "text": "text",
      "url": "url",
      "files": [
        {
          "name": "file",
          "accept": ["image/*", "application/pdf"]
        }
      ]
    }
  },
  "related_applications": [],
  "prefer_related_applications": false,
  "protocol_handlers": [
    {
      "protocol": "web+moocafisio",
      "url": "/?protocol=%s"
    }
  ]
}
