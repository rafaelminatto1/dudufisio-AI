#!/usr/bin/env sh
. "$(dirname -- "$0")/_/husky.sh"

# =============================================================================
# Pre-commit Hook - DuduFisio-AI
# =============================================================================
#
# Este hook executa verificações antes de cada commit para garantir qualidade
#
# =============================================================================

echo "🔍 Executando verificações pre-commit..."

# 1. Type-check
echo "\n📝 Verificando tipos TypeScript..."
npm run type-check || {
    echo "❌ Type-check falhou. Corrija os erros antes de commitar."
    exit 1
}

# 2. Lint
echo "\n✨ Executando ESLint..."
npm run lint || {
    echo "❌ ESLint falhou. Execute 'npm run lint:fix' ou corrija manualmente."
    exit 1
}

# 3. Testes unitários
echo "\n🧪 Executando testes unitários..."
npm run test:unit || {
    echo "❌ Testes falharam. Corrija os testes antes de commitar."
    exit 1
}

echo "\n✅ Todas as verificações passaram! Prosseguindo com commit...\n"
