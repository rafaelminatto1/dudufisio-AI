# Vercel Ignore - Simplificado para Next.js
# Apenas ignore o que realmente não é necessário no build

# Node modules (gerenciados pelo npm install na Vercel)
node_modules/

# Build artifacts locais (serão gerados durante o build)
.next/
out/
dist/
build/

# Ambiente de desenvolvimento
.env.local
.env.development
.env.test

# Testes (não necessários no build)
tests/
__tests__/
__mocks__/
testsprite_tests/
**/*.test.ts
**/*.test.tsx
**/*.spec.ts
**/*.spec.tsx
coverage/
playwright-report/
test-results/

# IDE e editores
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db

# Git (não necessário no build)
.git/
.github/

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Arquivos temporários e cache
.turbo/
.cache/
tmp/
temp/

# Arquivos de configuração local do Vercel
.vercel/

# Projeto antigo (backup) - CRÍTICO: Deve ser ignorado completamente
_OLD_PROJECT/
_OLD_PROJECT/**
**/_OLD_PROJECT/**

# Documentação (opcional - pode ser útil manter README.md)
# docs/
# *.md
# !README.md
