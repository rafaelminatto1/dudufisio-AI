# Vercel Ignore - Otimizado
# Apenas arquivos essenciais são enviados para o build

# 🔧 IMPORTANTE: package-lock.json DEVE ser enviado
!package-lock.json

# Node modules (gerenciados pelo npm install na Vercel)
node_modules/

# Ambiente de desenvolvimento
.env.local
.env.development
.env.test

# Testes completos
tests/
__tests__/
__mocks__/
testsprite_tests/
**/*.test.ts
**/*.test.tsx
**/*.spec.ts
**/*.spec.tsx
coverage/
playwright-report/
bundle-analysis/
logs/
reports/
reports/**
logs/**
test-results/

# Build artifacts locais
.vite/
dist/
build/
.next/
out/

# IDE e editores
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db

# Git
.git/
.github/
.gitignore
.gitattributes

# Documentação (não necessária no deploy)
docs/
*.md
!README.md
*.plan.md

# Garantir que scripts críticos sejam enviados
!scripts/
!scripts/**/*

# Scripts de desenvolvimento (mantemos scripts necessários para validação de build)
playwright.config.ts
playwright.config.performance.ts
vitest.config.ts
.eslintrc*.json
.prettierrc*

# Database e migrations locais (não usadas no build)
database/
prisma/
supabase/seed.sql
supabase/migrations/

# Arquivos de configuração desnecessários
.husky/
checkly/
mcp-server/
workers/
mobile-app/

# Source maps já gerados (incluídos no build se necessário)
**/*.map

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Arquivos temporários e cache
.turbo/
.cache/
tmp/
temp/

# Arquivos de configuração local
.env*.local
.vercel/

# Arquivos grandes de mídia não otimizada
**/*.psd
**/*.ai
**/*.sketch

# Arquivos de backup
**/*.bak
**/*.backup
**/*.old

