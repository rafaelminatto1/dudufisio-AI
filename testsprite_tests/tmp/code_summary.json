{
  "tech_stack": [
    "TypeScript",
    "React 19",
    "Vite",
    "TailwindCSS",
    "Supabase",
    "PostgreSQL",
    "React Router DOM",
    "React Hook Form",
    "Zod",
    "@react-pdf/renderer",
    "Framer Motion",
    "Lucide React"
  ],
  "features": [
    {
      "name": "Evolution Module - Exercise Prescription",
      "description": "Permite prescrever exercícios da biblioteca para pacientes com parâmetros específicos (séries, repetições, carga, duração)",
      "files": [
        "components/evolution/ExerciseSelector.tsx",
        "components/evolution/PrescribedExerciseList.tsx",
        "components/medical-records/EvolutionEditor.tsx",
        "services/exerciseService.ts",
        "types.ts"
      ],
      "endpoints": [
        {
          "method": "GET",
          "path": "/exercises",
          "description": "Lista exercícios da biblioteca com filtros"
        }
      ]
    },
    {
      "name": "Evolution Module - Templates",
      "description": "Sistema de templates reutilizáveis para evoluções SOAP com condutas e exercícios pré-definidos",
      "files": [
        "components/evolution/TemplateSelector.tsx",
        "components/evolution/TemplateSaveDialog.tsx",
        "services/evolutionTemplateService.ts",
        "types.ts"
      ],
      "endpoints": [
        {
          "method": "GET",
          "path": "/api/evolution-templates",
          "description": "Lista templates do terapeuta"
        },
        {
          "method": "POST",
          "path": "/api/evolution-templates",
          "description": "Cria novo template"
        },
        {
          "method": "PUT",
          "path": "/api/evolution-templates/:id/increment-usage",
          "description": "Incrementa contador de uso do template"
        }
      ]
    },
    {
      "name": "Evolution Module - Session Timer",
      "description": "Timer automático que rastreia a duração da sessão de atendimento",
      "files": [
        "components/evolution/SessionTimer.tsx",
        "components/medical-records/EvolutionEditor.tsx",
        "types.ts"
      ]
    },
    {
      "name": "Evolution Module - Progress Photos",
      "description": "Upload e gestão de fotos de progresso do paciente com legendas",
      "files": [
        "components/evolution/PhotoUpload.tsx",
        "services/storage/photoUploadService.ts",
        "components/medical-records/EvolutionEditor.tsx",
        "types.ts"
      ],
      "endpoints": [
        {
          "method": "POST",
          "path": "/storage/v1/object/progress-photos",
          "description": "Upload de foto de progresso (Supabase Storage)"
        },
        {
          "method": "DELETE",
          "path": "/storage/v1/object/progress-photos/:path",
          "description": "Remove foto de progresso"
        }
      ]
    },
    {
      "name": "Evolution Module - Previous Session Comparison",
      "description": "Exibe informações da última sessão do paciente para comparação rápida",
      "files": [
        "components/evolution/PreviousSessionComparison.tsx",
        "services/sessionEvolutionService.ts",
        "components/medical-records/EvolutionEditor.tsx",
        "types.ts"
      ],
      "endpoints": [
        {
          "method": "GET",
          "path": "/api/session-evolutions/patient/:patientId/latest",
          "description": "Obtém última sessão de evolução do paciente"
        }
      ]
    },
    {
      "name": "Evolution Module - PDF Export",
      "description": "Exportação profissional da evolução em formato PDF com todas as informações",
      "files": [
        "services/pdf/evolutionReportService.tsx",
        "components/medical-records/EvolutionEditor.tsx",
        "types.ts"
      ]
    },
    {
      "name": "Patient Management",
      "description": "Gestão completa de pacientes com histórico médico e evoluções",
      "files": [
        "pages/PatientListPage.tsx",
        "pages/PatientDetailPage.tsx",
        "services/patientService.ts",
        "types.ts"
      ],
      "endpoints": [
        {
          "method": "GET",
          "path": "/api/patients",
          "description": "Lista pacientes"
        },
        {
          "method": "GET",
          "path": "/api/patients/:id",
          "description": "Detalhes do paciente"
        }
      ]
    },
    {
      "name": "Appointment Scheduling",
      "description": "Agendamento de consultas com visualização em calendário",
      "files": [
        "pages/AgendaPage.tsx",
        "services/scheduling/appointmentService.ts",
        "types.ts"
      ],
      "endpoints": [
        {
          "method": "GET",
          "path": "/api/appointments",
          "description": "Lista agendamentos"
        },
        {
          "method": "POST",
          "path": "/api/appointments",
          "description": "Cria novo agendamento"
        }
      ]
    },
    {
      "name": "Authentication",
      "description": "Sistema de autenticação de usuários com Supabase Auth",
      "files": [
        "contexts/AuthContext.tsx",
        "lib/supabaseClient.ts",
        "types.ts"
      ],
      "endpoints": [
        {
          "method": "POST",
          "path": "/auth/v1/token",
          "description": "Login de usuário"
        },
        {
          "method": "POST",
          "path": "/auth/v1/logout",
          "description": "Logout de usuário"
        }
      ]
    },
    {
      "name": "Dashboard",
      "description": "Dashboard principal com KPIs e métricas da clínica",
      "files": [
        "pages/DashboardPageV2.tsx",
        "components/dashboard/KPIWidget.tsx",
        "services/database/mockData.ts",
        "types.ts"
      ]
    }
  ]
}
