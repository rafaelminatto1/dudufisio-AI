# FisioFlow - Variáveis de Ambiente para Produção
# Copie este arquivo para .env.production e preencha os valores reais

# ==============================================
# SUPABASE (Obrigatório)
# ==============================================
NEXT_PUBLIC_SUPABASE_URL=https://seu-projeto.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sua-chave-anonima-aqui

# ==============================================
# STRIPE (Pagamentos)
# ==============================================
STRIPE_SECRET_KEY=sk_live_...
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_live_...
STRIPE_WEBHOOK_SECRET=whsec_...

# ==============================================
# APP URL
# ==============================================
NEXT_PUBLIC_APP_URL=https://moocafisio.com.br

# ==============================================
# WHATSAPP BUSINESS API
# ==============================================
WHATSAPP_PROVIDER=whatsapp_business
WHATSAPP_API_KEY=sua-chave-whatsapp
WHATSAPP_PHONE_NUMBER_ID=seu-phone-id
WHATSAPP_BUSINESS_ACCOUNT_ID=seu-account-id
WHATSAPP_FROM_NUMBER=+5511XXXXXXXXX

# ==============================================
# EMAIL (Resend)
# ==============================================
EMAIL_PROVIDER=resend
EMAIL_API_KEY=re_...
EMAIL_FROM=noreply@moocafisio.com.br

# ==============================================
# CRON JOBS (Obrigatório para produção)
# ==============================================
CRON_SECRET=gere-uma-senha-forte-aqui-32-caracteres-minimo

# ==============================================
# MODO DE TESTE (NÃO USAR EM PRODUÇÃO)
# ==============================================
# TEST_MODE=false
# TEST_API_KEY=
#
# ⚠️ IMPORTANTE: Mantenha TEST_MODE comentado ou false em produção!
# ⚠️ Nunca faça commit de TEST_MODE=true para produção!

# ==============================================
# MONITORING (Opcional mas recomendado)
# ==============================================
# Sentry
SENTRY_DSN=https://...@sentry.io/...
SENTRY_AUTH_TOKEN=...

# Vercel Analytics (automático se usando Vercel)
# VERCEL_ANALYTICS_ID=...

# ==============================================
# RATE LIMITING (Opcional)
# ==============================================
# Upstash Redis para rate limiting
UPSTASH_REDIS_REST_URL=https://...
UPSTASH_REDIS_REST_TOKEN=...

# ==============================================
# SECURITY
# ==============================================
# Habilitar HTTPS em produção
NEXT_PUBLIC_FORCE_HTTPS=true

# CORS allowed origins (separados por vírgula)
CORS_ALLOWED_ORIGINS=https://moocafisio.com.br,https://www.moocafisio.com.br

# ==============================================
# LGPD / COMPLIANCE
# ==============================================
# Período de retenção de logs de auditoria (em dias)
AUDIT_LOG_RETENTION_DAYS=365

# ==============================================
# AI / OPENAI (Opcional)
# ==============================================
# OPENAI_API_KEY=sk-...
# OPENAI_ORG_ID=org-...

# ==============================================
# BACKUP (Opcional)
# ==============================================
# Configurações adicionais para backup
# BACKUP_STORAGE_BUCKET=backups
# BACKUP_RETENTION_DAYS=30
