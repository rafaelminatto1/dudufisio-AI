{
  "name": "DuduFisio-AI - Gestão Fisioterapêutica Inteligente",
  "short_name": "DuduFisio-AI",
  "description": "Sistema completo de gestão de clínicas de fisioterapia com IA integrada",
  "start_url": "/",
  "display": "standalone",
  "background_color": "#ffffff",
  "theme_color": "#3b82f6",
  "orientation": "portrait-primary",
  "scope": "/",
  "lang": "pt-BR",
  "dir": "ltr",
  "categories": ["health", "medical", "productivity", "business"],
  "icons": [
    {
      "src": "/favicon.ico",
      "sizes": "64x64 32x32 24x24 16x16",
      "type": "image/x-icon"
    },
    {
      "src": "/icon-192x192.png",
      "type": "image/png",
      "sizes": "192x192",
      "purpose": "any maskable"
    },
    {
      "src": "/icon-512x512.png",
      "type": "image/png",
      "sizes": "512x512",
      "purpose": "any maskable"
    },
    {
      "src": "/logo-1024.png",
      "type": "image/png",
      "sizes": "1024x1024",
      "purpose": "any"
    }
  ],
  "screenshots": [
    {
      "src": "/screenshots/dashboard.png",
      "type": "image/png",
      "sizes": "1280x720",
      "label": "Dashboard principal"
    },
    {
      "src": "/screenshots/agenda.png",
      "type": "image/png",
      "sizes": "1280x720",
      "label": "Agenda de atendimentos"
    },
    {
      "src": "/screenshots/pacientes.png",
      "type": "image/png",
      "sizes": "1280x720",
      "label": "Gestão de pacientes"
    }
  ],
  "shortcuts": [
    {
      "name": "Nova Consulta",
      "short_name": "Consulta",
      "description": "Agendar nova consulta",
      "url": "/agenda?action=new",
      "icons": [{ "src": "/icons/calendar.png", "sizes": "96x96" }]
    },
    {
      "name": "Pacientes",
      "short_name": "Pacientes",
      "description": "Ver lista de pacientes",
      "url": "/pacientes",
      "icons": [{ "src": "/icons/users.png", "sizes": "96x96" }]
    },
    {
      "name": "Financeiro",
      "short_name": "Financeiro",
      "description": "Dashboard financeiro",
      "url": "/financeiro",
      "icons": [{ "src": "/icons/money.png", "sizes": "96x96" }]
    }
  ],
  "share_target": {
    "action": "/share",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "title": "title",
      "text": "text",
      "url": "url",
      "files": [
        {
          "name": "documents",
          "accept": ["image/*", "application/pdf", ".doc", ".docx"]
        }
      ]
    }
  },
  "related_applications": [],
  "prefer_related_applications": false,
  "protocol_handlers": [
    {
      "protocol": "web+dudufisio",
      "url": "/handle-protocol?url=%s"
    }
  ],
  "permissions": [
    "notifications",
    "geolocation"
  ],
  "features": [
    "offline-support",
    "push-notifications",
    "background-sync",
    "installable"
  ]
}