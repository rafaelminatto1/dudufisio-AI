@tailwind base;
@tailwind components;
@tailwind utilities;

@layer base {
  :root {
    /* === CORES PRIMÁRIAS MODERNAS === */
    --primary-50: 240 249 255;   /* Sky ultra light - backgrounds sutis */
    --primary-100: 224 242 254;  /* Hover states delicados */
    --primary-500: 14 165 233;   /* Sky-500 - Ação principal */
    --primary-600: 2 132 199;    /* Hover de botões */
    --primary-700: 3 105 161;    /* Estados ativos */
    
    /* === CORES DE SAÚDE E BEM-ESTAR === */
    --health-success: 16 185 129;   /* Verde esmeralda - sucesso */
    --health-warning: 245 158 11;   /* Âmbar - atenção */
    --health-error: 239 68 68;      /* Vermelho coral - erro */
    --health-info: 139 92 246;      /* Violeta - informação */
    
    /* === CORES NEUTRAS SOFISTICADAS === */
    --neutral-0: 255 255 255;
    --neutral-50: 248 250 252;      /* Backgrounds principais */
    --neutral-100: 241 245 249;     /* Backgrounds secundários */
    --neutral-200: 226 232 240;     /* Borders sutis */
    --neutral-700: 51 65 85;        /* Textos primários */
    --neutral-900: 15 23 42;        /* Textos escuros */
    
    /* === GRADIENTES MODERNOS === */
    --gradient-primary: linear-gradient(135deg, rgb(14 165 233) 0%, rgb(139 92 246) 100%);
    --gradient-health: linear-gradient(135deg, rgb(16 185 129) 0%, rgb(14 165 233) 100%);
    --gradient-glow: radial-gradient(circle at 50% 0%, rgba(14,165,233,0.1) 0%, transparent 70%);
    
    /* === SISTEMA DE ESPAÇAMENTO 8PX BASE === */
    --space-1: 0.25rem;   /* 4px - micro espaços */
    --space-2: 0.5rem;    /* 8px - base unit */
    --space-3: 0.75rem;   /* 12px */
    --space-4: 1rem;      /* 16px - padrão entre elementos */
    --space-6: 1.5rem;    /* 24px - seções pequenas */
    --space-8: 2rem;      /* 32px - seções médias */
    --space-12: 3rem;     /* 48px - seções grandes */
    --space-16: 4rem;     /* 64px - separadores principais */
    --space-24: 6rem;     /* 96px - headers de página */
    
    /* === ELEVAÇÃO E SOMBRAS (DEPTH SYSTEM) === */
    --shadow-xs: 0 1px 2px 0 rgba(0,0,0,0.05);
    --shadow-sm: 0 1px 3px 0 rgba(0,0,0,0.1), 0 1px 2px -1px rgba(0,0,0,0.1);
    --shadow-md: 0 4px 6px -1px rgba(0,0,0,0.1), 0 2px 4px -2px rgba(0,0,0,0.1);
    --shadow-lg: 0 10px 15px -3px rgba(0,0,0,0.1), 0 4px 6px -4px rgba(0,0,0,0.1);
    --shadow-xl: 0 20px 25px -5px rgba(0,0,0,0.1), 0 8px 10px -6px rgba(0,0,0,0.1);
    --shadow-primary: 0 8px 16px -4px rgba(14,165,233,0.25);
    --shadow-success: 0 8px 16px -4px rgba(16,185,129,0.25);
    --shadow-glow: 0 0 20px rgba(14,165,233,0.15);
    
    /* === BORDER RADIUS MODERNO === */
    --radius-sm: 0.375rem;   /* 6px - inputs, tags */
    --radius-md: 0.5rem;     /* 8px - cards pequenos */
    --radius-lg: 0.75rem;    /* 12px - cards médios */
    --radius-xl: 1rem;       /* 16px - cards grandes */
    --radius-2xl: 1.5rem;    /* 24px - modais, containers */
    --radius-full: 9999px;   /* Círculos e pills */
    
    /* === SHADCN VARIABLES (COMPATIBILIDADE) === */
    --background: 0 0% 100%;
    --foreground: 222.2 84% 4.9%;
    --card: 0 0% 100%;
    --card-foreground: 222.2 84% 4.9%;
    --popover: 0 0% 100%;
    --popover-foreground: 222.2 84% 4.9%;
    --primary: 14 165 233;   /* Usando nossa cor primária */
    --primary-foreground: 0 0% 100%;
    --secondary: 210 40% 96%;
    --secondary-foreground: 222.2 47.4% 11.2%;
    --muted: 210 40% 96%;
    --muted-foreground: 215.4 16.3% 46.9%;
    --accent: 210 40% 96%;
    --accent-foreground: 222.2 47.4% 11.2%;
    --destructive: 239 68 68; /* Usando nossa cor de erro */
    --destructive-foreground: 0 0% 100%;
    --border: 214.3 31.8% 91.4%;
    --input: 214.3 31.8% 91.4%;
    --ring: 14 165 233;       /* Usando nossa cor primária */
    --radius: 0.5rem;
  }

  .dark {
    /* === DARK BACKGROUND LAYERS === */
    --dark-bg-base: 10 15 30;      /* Background principal */
    --dark-bg-elevated: 17 24 39;  /* Cards e elementos elevados */
    --dark-bg-subtle: 30 41 59;    /* Hover states */
    
    /* === DARK TEXT === */
    --dark-text-primary: 241 245 249;
    --dark-text-secondary: 203 213 225;
    --dark-text-tertiary: 148 163 184;
    
    /* === DARK BORDERS === */
    --dark-border: rgba(255,255,255,0.1);
    --dark-border-focus: rgba(14,165,233,0.5);
    
    /* === SHADCN DARK VARIABLES === */
    --background: 10 15 30;       /* Usando nossa cor dark base */
    --foreground: 241 245 249;    /* Usando nossa cor dark text primary */
    --card: 17 24 39;             /* Usando nossa cor dark elevated */
    --card-foreground: 241 245 249;
    --popover: 17 24 39;
    --popover-foreground: 241 245 249;
    --primary: 14 165 233;        /* Mantendo cor primária */
    --primary-foreground: 10 15 30;
    --secondary: 30 41 59;        /* Usando nossa cor dark subtle */
    --secondary-foreground: 241 245 249;
    --muted: 30 41 59;
    --muted-foreground: 148 163 184; /* Usando nossa cor dark tertiary */
    --accent: 30 41 59;
    --accent-foreground: 241 245 249;
    --destructive: 239 68 68;
    --destructive-foreground: 0 0% 100%;
    --border: 30 41 59;
    --input: 30 41 59;
    --ring: 14 165 233;
  }
}

@layer utilities {
  /* === CONTAINERS E LAYOUTS === */
  .container-responsive {
    @apply px-4 sm:px-6 lg:px-8 mx-auto max-w-7xl;
  }
  
  .card-responsive {
    @apply p-4 sm:p-5 lg:p-6;
  }
  
  .grid-responsive {
    @apply grid gap-4 sm:gap-5 lg:gap-6;
  }
  
  /* === TIPOGRAFIA MODERNA === */
  .text-responsive {
    @apply text-sm sm:text-base;
  }
  
  .heading-responsive {
    @apply text-xl sm:text-2xl lg:text-3xl;
  }
  
  .heading-lg-responsive {
    @apply text-2xl sm:text-3xl lg:text-4xl xl:text-5xl;
  }
  
  /* === GRADIENTES E BACKGROUNDS === */
  .bg-gradient-primary {
    background: var(--gradient-primary);
  }
  
  .bg-gradient-health {
    background: var(--gradient-health);
  }
  
  .bg-gradient-glow {
    background: var(--gradient-glow);
  }
  
  /* === SOMBRAS MODERNAS === */
  .shadow-primary {
    box-shadow: var(--shadow-primary);
  }
  
  .shadow-success {
    box-shadow: var(--shadow-success);
  }
  
  .shadow-glow {
    box-shadow: var(--shadow-glow);
  }
  
  /* === GLASSMORPHISM EFFECTS === */
  .glass-card {
    @apply bg-white/80 backdrop-blur-md border border-white/20;
  }
  
  .glass-card-dark {
    @apply bg-gray-900/80 backdrop-blur-md border border-gray-700/20;
  }
  
  .glass-nav {
    @apply bg-white/95 backdrop-blur-lg border-b border-white/20;
  }
  
  .glass-nav-dark {
    @apply bg-gray-900/95 backdrop-blur-lg border-b border-gray-700/20;
  }
  
  /* === HOVER EFFECTS === */
  .hover-lift {
    @apply transition-all duration-300 hover:-translate-y-1 hover:shadow-lg;
  }
  
  .hover-glow {
    @apply transition-all duration-300 hover:shadow-primary;
  }
  
  .hover-scale {
    @apply transition-transform duration-200 hover:scale-105;
  }
  
  /* === ANIMAÇÕES AVANÇADAS === */
  .animate-fade-in-up {
    animation: fadeInUp 0.6s ease-out;
  }
  
  .animate-slide-in-left {
    animation: slideInLeft 0.5s ease-out;
  }
  
  .animate-slide-in-right {
    animation: slideInRight 0.5s ease-out;
  }
  
  .animate-scale-in {
    animation: scaleIn 0.3s ease-out;
  }
  
  .animate-pulse-glow {
    animation: pulseGlow 2s ease-in-out infinite;
  }
  
  /* === ESTADOS INTERATIVOS === */
  .interactive-button {
    @apply relative overflow-hidden transition-all duration-200 active:scale-95;
  }
  
  .interactive-button::before {
    content: '';
    @apply absolute inset-0 bg-white/20 opacity-0 transition-opacity duration-200;
  }
  
  .interactive-button:hover::before {
    @apply opacity-100;
  }
  
  /* === LOADING STATES === */
  .skeleton {
    @apply animate-pulse bg-gray-200 rounded;
  }
  
  .skeleton-dark {
    @apply animate-pulse bg-gray-700 rounded;
  }
  
  .shimmer {
    background: linear-gradient(90deg, transparent, rgba(255,255,255,0.4), transparent);
    animation: shimmer 2s infinite;
  }
  
  /* Alvos de toque acessíveis */
  .touch-target {
    @apply min-h-[44px] min-w-[44px];
  }
  
  /* Scroll horizontal suave */
  .scroll-horizontal {
    @apply overflow-x-auto scrollbar-thin scrollbar-thumb-slate-300 scrollbar-track-transparent;
  }
  
  /* Layout flex responsivo */
  .flex-responsive {
    @apply flex flex-col sm:flex-row;
  }
  
  /* Espaçamento responsivo */
  .space-responsive {
    @apply space-y-4 sm:space-y-6 lg:space-y-8;
  }
  
  .space-x-responsive {
    @apply space-x-2 sm:space-x-4 lg:space-x-6;
  }
  
  /* Chart containers responsivos */
  .chart-container {
    @apply w-full h-[200px] sm:h-[250px] lg:h-[300px] xl:h-[350px];
  }
  
  /* Tabs responsivas */
  .tabs-responsive {
    @apply overflow-x-auto scrollbar-hide;
  }
  
  .tabs-list-responsive {
    @apply flex w-full min-w-max;
  }
  
  /* Modal responsivo */
  .modal-responsive {
    @apply w-full h-full sm:h-auto sm:max-w-lg sm:rounded-lg;
  }
  
  /* Sidebar responsivo */
  .sidebar-responsive {
    @apply fixed inset-y-0 left-0 z-50 w-64 transform transition-transform duration-200 ease-in-out;
  }
  
  .sidebar-responsive.closed {
    @apply -translate-x-full;
  }
  
  /* Data table responsivo */
  .table-responsive {
    @apply min-w-full overflow-x-auto;
  }
  
  /* Button responsivo */
  .btn-responsive {
    @apply touch-target px-4 py-2 text-sm sm:text-base;
  }
  
  /* Input responsivo */
  .input-responsive {
    @apply w-full px-3 py-2 text-sm sm:text-base;
  }
  
  /* Card hover responsivo */
  .card-hover-responsive {
    @apply transition-all duration-200 hover:shadow-md hover:-translate-y-0.5;
  }
  
  /* Truncate responsivo */
  .truncate-responsive {
    @apply truncate sm:whitespace-normal;
  }
  
  /* Hide em mobile */
  .hidden-mobile {
    @apply hidden sm:block;
  }
  
  /* Show apenas em mobile */
  .mobile-only {
    @apply block sm:hidden;
  }
  
  /* Hide em desktop */
  .hidden-desktop {
    @apply block sm:hidden;
  }
  
  /* Show apenas em desktop */
  .desktop-only {
    @apply hidden sm:block;
  }
  
  /* Grid colunas responsivas */
  .grid-1-2-3-4 {
    @apply grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4;
  }
  
  .grid-1-2-4 {
    @apply grid-cols-1 sm:grid-cols-2 lg:grid-cols-4;
  }
  
  .grid-1-2-3 {
    @apply grid-cols-1 sm:grid-cols-2 lg:grid-cols-3;
  }
  
  /* Animações responsivas */
  .animate-fade-in {
    animation: fadeIn 0.3s ease-in-out;
  }
  
  .animate-slide-up {
    animation: slideUp 0.3s ease-out;
  }
  
  .animate-scale-in {
    animation: scaleIn 0.2s ease-out;
  }
}

@keyframes fadeIn {
  from {
    opacity: 0;
  }
  to {
    opacity: 1;
  }
}

@keyframes slideUp {
  from {
    transform: translateY(10px);
    opacity: 0;
  }
  to {
    transform: translateY(0);
    opacity: 1;
  }
}

@keyframes scaleIn {
  from {
    transform: scale(0.95);
    opacity: 0;
  }
  to {
    transform: scale(1);
    opacity: 1;
  }
}

@keyframes fadeInUp {
  from {
    opacity: 0;
    transform: translateY(30px);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

@keyframes slideInLeft {
  from {
    opacity: 0;
    transform: translateX(-30px);
  }
  to {
    opacity: 1;
    transform: translateX(0);
  }
}

@keyframes slideInRight {
  from {
    opacity: 0;
    transform: translateX(30px);
  }
  to {
    opacity: 1;
    transform: translateX(0);
  }
}

@keyframes pulseGlow {
  0%, 100% {
    box-shadow: 0 0 20px rgba(14,165,233,0.3);
  }
  50% {
    box-shadow: 0 0 30px rgba(14,165,233,0.6);
  }
}

@keyframes shimmer {
  0% {
    transform: translateX(-100%);
  }
  100% {
    transform: translateX(100%);
  }
}

@layer base {
  * {
    @apply border-border;
  }
  body {
    @apply bg-background text-foreground;
  }
}

/* Custom styles */
html, body, #root {
  height: 100%;
  font-family: 'Inter', sans-serif;
}

/* Custom scrollbar for a more modern look */
::-webkit-scrollbar {
  width: 8px;
  height: 8px;
}

::-webkit-scrollbar-track {
  background: #f1f5f9;
}

::-webkit-scrollbar-thumb {
  background: #94a3b8;
  border-radius: 10px;
}

::-webkit-scrollbar-thumb:hover {
  background: #64748b;
}

/* App Shell Loader Styles */
.app-shell-loader {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  height: 100%;
  width: 100%;
}

.app-shell-loader .loader-container {
  position: relative;
  display: flex;
  align-items: center;
  justify-content: center;
}

.app-shell-loader .spinner {
  position: absolute;
  width: 96px; /* 24 * 4 */
  height: 96px;
  border-radius: 50%;
  border: 3px solid #93c5fd; /* sky-300 */
  border-top-color: #0ea5e9; /* sky-500 */
  animation: spin 1s linear infinite;
}

.app-shell-loader .logo {
  width: 64px; /* 16 * 4 */
  height: 64px;
  color: #0ea5e9; /* sky-500 */
}

.app-shell-loader p {
  margin-top: 1.5rem; /* 24px */
  font-size: 1.125rem; /* 18px */
  font-weight: 600;
  color: #334155; /* slate-700 */
}

@keyframes spin {
  to {
    transform: rotate(360deg);
  }
}

