{
  "framework": "nextjs",
  "crons": [
    {
      "path": "/api/cron/backup-database",
      "schedule": "0 2 * * *"
    },
    {
      "path": "/api/cron/lembretes-diarios",
      "schedule": "0 9 * * 1-5"
    }
  ],
  "github": {
    "silent": false,
    "autoAlias": true,
    "autoAssignReviewers": true,
    "autoMerge": false,
    "enabled": true,
    "checks": [
      "npm run lint",
      "npm run test",
      "npm run e2e"
    ]
  }
}