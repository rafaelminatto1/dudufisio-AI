{
  "crons": [
    {
      "path": "/api/cron/send-reminders",
      "schedule": "0 8,20 * * *"
    },
    {
      "path": "/api/cron/cleanup-old-links",
      "schedule": "0 3 * * *"
    },
    {
      "path": "/api/cron/sync-calendar-access",
      "schedule": "*/15 * * * *"
    }
  ],
  "headers": [
    {
      "source": "/api/calendar/(.*)",
      "headers": [
        {
          "key": "Access-Control-Allow-Origin",
          "value": "*"
        },
        {
          "key": "Access-Control-Allow-Methods",
          "value": "GET, OPTIONS"
        },
        {
          "key": "Access-Control-Allow-Headers",
          "value": "Content-Type"
        }
      ]
    }
  ]
}
