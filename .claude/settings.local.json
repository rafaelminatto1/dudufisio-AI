{
  "permissions": {
    "allow": [
      "Bash(Select-Object ProcessName, Id, CPU)",
      "Bash(Format-Table)",
      "Bash(Select-Object -First 50)",
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(git push:*)",
      "Bash(git checkout:*)",
      "Bash(npm run build:analyze:*)",
      "Bash(npx playwright test:*)",
      "Bash(dir:*)",
      "Bash(findstr:*)",
      "Bash(Select-String -Pattern \"format\" -Context 3)",
      "Bash(cat:*)",
      "Bash(npm install:*)",
      "Bash(mkdir:*)",
      "Bash(if [ -d \"dist/assets\" ])",
      "Bash(then ls -lh dist/assets/*.js)",
      "Bash(awk:*)",
      "Bash(else echo \"Build não encontrado. Execute npm run build primeiro.\")",
      "Bash(fi)",
      "Bash(node scripts/analyze-bundle-size.js:*)",
      "Bash(node scripts/analyze-bundle-size.cjs:*)",
      "Bash(npm run build:*)",
      "Bash(node scripts/find-uncategorized-deps.cjs:*)",
      "Bash(if [ -f \".mcp.json\" ])",
      "Bash(then cat .mcp.json)",
      "Bash(else echo \"Arquivo não encontrado\")",
      "Bash(npm run bundle:analyze:size:*)",
      "Bash(nul)",
      "Bash(Select-Object -First 15)"
    ],
    "deny": [],
    "ask": []
  },
  "enableAllProjectMcpServers": true,
  "enabledMcpjsonServers": [
    "shadcn"
  ],
  "mcpServers": {
    "supabase": {
      "transport": "http",
      "url": "https://mcp.supabase.com/mcp"
    }
  }
}
