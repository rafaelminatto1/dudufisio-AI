{
  "permissions": {
    "allow": [
      "Bash(Select-Object ProcessName, Id, CPU)",
      "Bash(Format-Table)",
      "Bash(Select-Object -First 50)",
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(git push:*)",
      "Bash(git checkout:*)",
      "Bash(npm run build:analyze:*)",
      "Bash(npx playwright test:*)",
      "Bash(dir:*)",
      "Bash(findstr:*)",
      "Bash(Select-String -Pattern \"format\" -Context 3)",
      "Bash(cat:*)"
    ],
    "deny": [],
    "ask": []
  },
  "enableAllProjectMcpServers": true,
  "enabledMcpjsonServers": [
    "shadcn"
  ],
  "mcpServers": {
    "supabase": {
      "transport": "http",
      "url": "https://mcp.supabase.com/mcp"
    }
  }
}
