{
  "permissions": {
    "allow": [
      "Bash(rm:*)",
      "Bash(vercel logs:*)",
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(git push)",
      "Bash(vercel:*)",
      "Bash(npm run build:*)",
      "Bash(git push:*)",
      "Bash(curl:*)",
      "Bash(npm run type-check:*)",
      "Bash(npx tsc:*)",
      "Bash(Select-String -Pattern \"admin-dashboard\" -Context 0,2)",
      "Bash(npx playwright test:*)",
      "Bash(timeout 60 npx playwright test:*)",
      "Bash(Remove-Item -Path \"test-results\" -Recurse -Force -ErrorAction SilentlyContinue)",
      "Bash(npx playwright show-report)",
      "Bash(cat:*)",
      "Bash(npm run dev:*)",
      "Bash(timeout /t 8 /nobreak)",
      "Bash(Select-String -Pattern \"test\")",
      "Bash(Select-Object -First 10)",
      "Bash(/dev/null)",
      "Bash(timeout /t 5 /nobreak)",
      "Bash(timeout /t 3 /nobreak)",
      "Bash(timeout 90 npx playwright test:*)"
    ],
    "deny": [],
    "ask": []
  },
  "enableAllProjectMcpServers": true,
  "enabledMcpjsonServers": [
    "shadcn"
  ],
  "mcpServers": {
    "supabase": {
      "transport": "http",
      "url": "https://mcp.supabase.com/mcp"
    }
  }
}
